# Copia este archivo como .env y rellena la contrasena de aplicacion.
AIRFLOW_UID=1000
TZ=America/Lima
AIRFLOW__CORE__DEFAULT_TIMEZONE=America/Lima
AIRFLOW__WEBSERVER__DEFAULT_UI_TIMEZONE=America/Lima

# --- Servidor SMTP para las notificaciones por correo ---
# Gmail exige una "contrasena de aplicacion", no la del correo.
# Se genera en https://myaccount.google.com/apppasswords
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=orodrigohr@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=CONTRASENA_DE_APLICACION_AQUI
AIRFLOW__SMTP__SMTP_MAIL_FROM=orodrigohr@gmail.com

NOTIFICATION_EMAIL=orodrigohr@gmail.com
